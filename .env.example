# Copy this file to .env for local development. The weather-prediction MCP
# server needs NO secrets (Open-Meteo is key-less) - the only knobs are shown
# below and are optional (they have code defaults).

# Weather dashboard default city (used by weather_dashboard/).
WEATHER_DASHBOARD_CITY=Chicago

# ---- Legacy Day 3 (Alpaca) vars - kept for the reference apps only ----
# In production on Databricks Apps these are injected from Databricks secrets
# via app.yaml - do NOT put real secret values in this file or commit a
# filled-in .env.
LAKEBASE_URL=postgresql://<role>:<password>@<your-lakebase-host>.database.cloud.databricks.com:5432/databricks_postgres?sslmode=require

PAPER_STARTING_CASH=100000
PAPER_ACCOUNT_ID=agent-bricks-demo
